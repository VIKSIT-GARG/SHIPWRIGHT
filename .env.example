# Provider selection: ollama, openai, openrouter, anthropic, gemini, or another preset.
SHIPWRIGHT_PROVIDER=ollama

# Ollama defaults to the local server. No API key is needed for Ollama.
SHIPWRIGHT_BASE_URL=http://127.0.0.1:11434
SHIPWRIGHT_MODEL=qwen2.5-coder:7b
SHIPWRIGHT_TIMEOUT=60

# Set this for OpenAI-compatible providers, or use the provider-specific variables below.
SHIPWRIGHT_API_KEY=

# Provider-specific fallbacks. Keep real values out of Git.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
